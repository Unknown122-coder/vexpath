# Copy to .env for local development. docker compose reads this file.
# Never commit .env.

# --- Database ---------------------------------------------------------------
# Local docker compose default. In production this is the Neon connection
# string. One URL serves both synchronous and asynchronous access: the driver
# is rewritten to psycopg either way, so a string pasted from a hosting
# provider works unchanged (see packages/db/src/vexpath_db/engine.py).
VEXPATH_DATABASE_URL=postgresql+psycopg://vexpath:vexpath@localhost:5432/vexpath

# --- Object storage (Cloudflare R2 in production) ---------------------------
# Unused until M3, when the first artefact is written. No local emulator has
# been chosen yet; see docs/adr/0002-postgres-and-object-storage.md.
VEXPATH_S3_ENDPOINT_URL=
VEXPATH_S3_BUCKET=vexpath-artifacts
VEXPATH_S3_ACCESS_KEY_ID=vexpath-local
VEXPATH_S3_SECRET_ACCESS_KEY=vexpath-local-secret
VEXPATH_S3_REGION=auto

# --- Application ------------------------------------------------------------
VEXPATH_ENV=local
VEXPATH_BASE_URL=http://localhost:8000
# Used to sign session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
VEXPATH_SECRET_KEY=change-me-in-every-environment
VEXPATH_LOG_LEVEL=INFO
VEXPATH_LOG_FORMAT=console

# --- Advisory data ----------------------------------------------------------
# When set, the CLI and workers read advisories from this local snapshot instead
# of calling the OSV API. The frozen test snapshot lives in testdata/advisories.
VEXPATH_ADVISORY_SNAPSHOT_DIR=
VEXPATH_OSV_API_BASE=https://api.osv.dev
# Optional: raises GitHub API rate limits for patch diffing and PR resolution.
VEXPATH_GITHUB_TOKEN=

# --- Observability ----------------------------------------------------------
# Absent, nothing is reported anywhere, which is the right default for a tool
# people run against their own code. When set, request bodies, headers,
# cookies and stack-frame locals are all deliberately withheld: a scan
# upload's body is a dependency inventory and a frame inside the scanner holds
# the source it was parsing (see vexpath_platform/tracing.py).
VEXPATH_SENTRY_DSN=
# Performance tracing. A trace carries URLs and timings from every request, so
# this is a decision about what leaves the process, not a tuning knob.
VEXPATH_SENTRY_TRACES_SAMPLE_RATE=0.0
# The build this process is. Set from the commit SHA in CI.
VEXPATH_RELEASE=

# --- Rate limiting ----------------------------------------------------------
VEXPATH_RATE_LIMIT_ENABLED=true
# Whether X-Forwarded-For may be believed. Leave false unless a known proxy
# terminates the connection: that header is a request header like any other,
# so trusting it without a proxy lets a caller evade their own limit by
# varying it and exhaust somebody else's by claiming their address.
VEXPATH_TRUST_PROXY_HEADERS=false

# --- Sign in with GitHub ----------------------------------------------------
# Create an OAuth app at https://github.com/settings/developers with the
# callback URL <VEXPATH_BASE_URL>/auth/github/callback. Both halves or neither:
# a client id with no secret produces an authorisation redirect that fails at
# the exchange, which is the most confusing possible way to be misconfigured,
# so the sign-in page says it is unavailable until both are set.
VEXPATH_GITHUB_CLIENT_ID=
VEXPATH_GITHUB_CLIENT_SECRET=
# Only for GitHub Enterprise or a test stand-in.
VEXPATH_GITHUB_OAUTH_BASE=https://github.com
VEXPATH_GITHUB_API_BASE=https://api.github.com
