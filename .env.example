# Copy to .env for local development. docker compose reads this file.
# Never commit .env.

# --- Database ---------------------------------------------------------------
# Local docker compose default. In production this is the Neon connection
# string. One URL serves both synchronous and asynchronous access: the driver
# is rewritten to psycopg either way, so a string pasted from a hosting
# provider works unchanged (see packages/db/src/vexpath_db/engine.py).
VEXPATH_DATABASE_URL=postgresql+psycopg://vexpath:vexpath@localhost:5432/vexpath

# --- Object storage (Cloudflare R2 in production) ---------------------------
# Unused until M3, when the first artefact is written. No local emulator has
# been chosen yet; see docs/adr/0002-postgres-and-object-storage.md.
VEXPATH_S3_ENDPOINT_URL=
VEXPATH_S3_BUCKET=vexpath-artifacts
VEXPATH_S3_ACCESS_KEY_ID=vexpath-local
VEXPATH_S3_SECRET_ACCESS_KEY=vexpath-local-secret
VEXPATH_S3_REGION=auto

# --- Application ------------------------------------------------------------
VEXPATH_ENV=local
VEXPATH_BASE_URL=http://localhost:8000
# Used to sign session cookies. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
VEXPATH_SECRET_KEY=change-me-in-every-environment
VEXPATH_LOG_LEVEL=INFO
VEXPATH_LOG_FORMAT=console

# --- Advisory data ----------------------------------------------------------
# When set, the CLI and workers read advisories from this local snapshot instead
# of calling the OSV API. The frozen test snapshot lives in testdata/advisories.
VEXPATH_ADVISORY_SNAPSHOT_DIR=
VEXPATH_OSV_API_BASE=https://api.osv.dev
# Optional: raises GitHub API rate limits for patch diffing and PR resolution.
VEXPATH_GITHUB_TOKEN=

# --- GitHub OAuth login (M4; leave blank until then) ------------------------
VEXPATH_GITHUB_OAUTH_CLIENT_ID=
VEXPATH_GITHUB_OAUTH_CLIENT_SECRET=
